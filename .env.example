# Names only. Copy to .env.local and fill in. Never commit real values.

# Local Postgres from `npm run db:up` (docker compose maps it to 5433).
DATABASE_URL=postgres://levypass:levypass@localhost:5433/levypass
# Integration tests use their own database; it is migrated before each run.
TEST_DATABASE_URL=postgres://levypass:levypass@localhost:5433/levypass_test

PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# fake (local and tests) or xtradot (cluster only).
BANK_ADAPTER=fake
BANK_API_BASE_URL=http://bank-api.ingress-apisix.svc.cluster.local/v1
MAAS_BASE_URL=
MAAS_MODEL=glm-5.3

# In the cluster this comes from the huawei-gateway secret via envFrom. Never set it locally.
GATEWAY_KEY=

# Ed25519 private key, PKCS8 DER, base64. Generate locally with:
#   node -e "const {generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
QR_SIGNING_KEY=
# At least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Container registry for `npm run deploy` (H2).
IMAGE_REPO=

# Demo logins written by `npm run db:seed`. Required when NODE_ENV=production; local defaults otherwise.
SEED_ADMIN_PASSWORD=
SEED_OFFICER_PIN=
